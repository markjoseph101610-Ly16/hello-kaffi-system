# ===== Hello Kaffi - BACKEND (Render) =====
# This file is a TEMPLATE. Do NOT commit your real .env.
# On Render: Dashboard > your service > Environment > add each line below as a variable.
# (Render never reads your local .env - it is git-ignored, so it is not deployed.)

# --- Database (Supabase) - keep your existing values ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Sessions - any long random text, keep it the same forever ---
SESSION_SECRET=PASTE_A_LONG_RANDOM_STRING

# --- Email (OTP) - keep your existing values ---
BREVO_API_KEY=PASTE_YOUR_BREVO_API_KEY
BREVO_SENDER=your-verified-sender@gmail.com

# --- NEW: needed for "Continue with Google" ---
# Firebase console > Project settings (gear) > Service accounts > Generate new private key (project: hello-kaffi-hybrid).
# Open the downloaded .json, copy ALL of it, paste as ONE line. (Or base64 of the file.)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"hello-kaffi-hybrid", ...paste the rest...}

# --- NEW: websites allowed to call this API (your Vercel URL(s), comma-separated, no trailing slash) ---
ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
